# ==============================================================================
# LK BAKEHOUSE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT CONFIGURATION (Public / Frontend & Backend)
# ------------------------------------------------------------------------------
# In Supabase Dashboard -> Project Settings -> API:
# VITE_SUPABASE_URL: Project URL (e.g., https://abcdefghijklm.supabase.co)
# VITE_SUPABASE_ANON_KEY: Project API Key (anon / public key)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ------------------------------------------------------------------------------
# 2. SUPABASE SERVER / SERVICE-ROLE CONFIGURATION (Server-Side ONLY)
# ------------------------------------------------------------------------------
# NEVER expose the service_role key to client browsers or frontend code!
# Found in Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ------------------------------------------------------------------------------
# 3. DIRECT POSTGRESQL DATABASE CONNECTION (Server-Side ONLY)
# ------------------------------------------------------------------------------
# Option A: Full Connection URI from Supabase:
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Note: Use port 5432 for session mode or port 6543 for transaction pooling.
SUPABASE_DB_URL="postgresql://postgres.your-ref:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# Option B: Individual PostgreSQL parameters (or Cloud SQL / Local PG)
# Host, port, user, password, database
SUPABASE_DB_HOST="db.your-project-id.supabase.co"
SUPABASE_DB_PORT="5432"
SUPABASE_DB_USER="postgres"
SUPABASE_DB_PASSWORD="your-strong-db-password"
SUPABASE_DB_NAME="postgres"

# ------------------------------------------------------------------------------
# 4. BAKERY DEPLOYMENT & PLATFORM CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Optional Gemini AI key (automatically injected in AI Studio runtime)
GEMINI_API_KEY=""
